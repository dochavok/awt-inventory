{
  "name": "awt-inventory",
  "version": "0.10.0",
  "private": true,
  "description": "Inventory, skills and totals for Adventures from the Wizards Tower characters, as a phone-first web app.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-awt-inventory",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --project unit",
    "test:access": "firebase emulators:exec --only firestore,auth --project demo-awt-inventory \"vitest run --project access\"",
    "test:browser": "playwright test",
    "lint": "eslint . && prettier --check . && tsc",
    "format": "prettier --write .",
    "coverage:write": "tsx scripts/coverage.ts --write",
    "coverage:check": "tsx scripts/coverage.ts --check",
    "docs:write": "tsx scripts/generate-docs.ts --write",
    "check:test-changes": "tsx scripts/check-test-changes.ts"
  },
  "awt": {
    "finishedMilestones": [
      "M1",
      "M2",
      "M3",
      "M4"
    ]
  },
  "dependencies": {
    "@sentry/browser": "11.16.0",
    "firebase": "13.4.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "firebase-tools": "15.37.0",
    "marked": "18.2.1",
    "prettier": "3.10.1",
    "superstatic": "10.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "@firebase/util": false,
    "esbuild": false,
    "protobufjs": false,
    "re2": false
  }
}
