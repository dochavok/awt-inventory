{
  "name": "awt-inventory-functions",
  "private": true,
  "description": "AWT Inventory's Cloud Functions: reports to the maintainer (SP-1 to SP-3) and nightly backups (NF-10).",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --packages=external --outfile=lib/index.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@firebase/util": false,
    "esbuild": false,
    "protobufjs": false
  }
}
