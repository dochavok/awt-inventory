rules_version = '2';

// Server-side access rules (PV-1, NF-6, NF-7, NF-13). Tested against the
// emulator in tests/access/. Every collection is listed: anything not matched
// here is refused, so a later milestone's collection stays closed until its
// rules are written. Records may hold only their own
// fields, with the app's maximum sizes (NF-6, src/data/validate.ts LIMITS).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A user's records can be written once their profile exists, which only an invited email can create (NF-13),
    // and their email is verified, so the sign-in belongs to that email's owner (AC-1).
    function canStore(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(uid));
    }

    // NF-13: before 1.0, only an email on the invite list can create a profile.
    function invited() {
      return request.auth.token.email != null
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    // An optional text field: absent, or text of at most `max` characters.
    function text(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // An optional link (IN-11): at most 2,000 characters, starting http:// or
    // https://. The app (src/data/validate.ts webLink) also checks it parses.
    function webLink(data, field) {
      return !(field in data) || (text(data, field, 2000) && data[field].matches('(?i)https?://\\S+'));
    }

    function wholeNumber(data, field) {
      return !(field in data) || data[field] is int;
    }

    function shortList(data, field) {
      return !(field in data) || (data[field] is list && data[field].size() <= 50);
    }

    // NF-3: each changed field records when it was changed (`edited`, in
    // milliseconds). The later change wins: a change older than the one already
    // stored is refused, whichever phone syncs last, even one that sets the same
    // value (else it would move the field's edit time back).
    function edits(data) {
      return !('edited' in data) || (data.edited is map && data.edited.size() <= 30);
    }

    function editedAt(data, field) {
      return data.get('edited', {}).get(field, 0);
    }

    function fresh(changed, field) {
      return !changed.hasAny([field])
        || (editedAt(request.resource.data, field) >= editedAt(resource.data, field)
            && editedAt(request.resource.data, field) <= request.time.toMillis() + 300000);
    }

    // The fields whose value or edit time this write changes.
    function changedKeys() {
      let editedNow = request.resource.data.get('edited', {});
      let editedBefore = resource.data.get('edited', {});
      return request.resource.data.diff(resource.data).affectedKeys()
        .union(editedNow.diff(editedBefore).affectedKeys());
    }

    function freshCharacter() {
      let changed = changedKeys();
      return fresh(changed, 'name') && fresh(changed, 'className') && fresh(changed, 'level')
        && fresh(changed, 'notes') && fresh(changed, 'retired');
    }

    function freshTitle() {
      let changed = changedKeys();
      return fresh(changed, 'name') && fresh(changed, 'description') && fresh(changed, 'earned')
        && fresh(changed, 'scope') && fresh(changed, 'grants');
    }

    function freshEntry() {
      let changed = changedKeys();
      return fresh(changed, 'name') && fresh(changed, 'description') && fresh(changed, 'notes')
        && fresh(changed, 'itemFamily') && fresh(changed, 'rarity') && fresh(changed, 'hands')
        && fresh(changed, 'range') && fresh(changed, 'weaponGroup') && fresh(changed, 'extraDamage')
        && fresh(changed, 'slotKind') && fresh(changed, 'arcane') && fresh(changed, 'allyType')
        && fresh(changed, 'hearts') && fresh(changed, 'active') && fresh(changed, 'tier')
        && fresh(changed, 'howGained') && fresh(changed, 'levelGained') && fresh(changed, 'grants');
    }

    // PV-2: a profile holds only the display name and the sign-in email.
    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly(['displayName', 'email'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && (!('email' in data) || data.email == request.auth.token.email);
    }

    function validTitle() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'description', 'earned', 'scope', 'grants', 'edited']) && edits(data)
        && text(data, 'name', 100) && text(data, 'description', 10000) && text(data, 'earned', 10)
        && (!('scope' in data) || (data.scope is map && data.scope.keys().hasOnly(['level', 'characterId'])
            && text(data.scope, 'level', 20) && text(data.scope, 'characterId', 100)))
        && shortList(data, 'grants');
    }

    function validCharacter() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'className', 'level', 'notes', 'retired', 'edited']) && edits(data)
        && text(data, 'name', 100) && text(data, 'className', 20) && wholeNumber(data, 'level')
        && text(data, 'notes', 10000) && (!('retired' in data) || data.retired is bool);
    }

    function validEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly(['category', 'name', 'quantity', 'description', 'notes', 'itemFamily', 'grants',
          'rarity', 'hands', 'range', 'weaponGroup', 'extraDamage', 'slotKind', 'arcane', 'allyType', 'hearts',
          'active', 'tier', 'skillId', 'howGained', 'levelGained', 'edited']) && edits(data)
        && text(data, 'category', 20) && text(data, 'name', 100) && wholeNumber(data, 'quantity')
        && text(data, 'description', 10000) && text(data, 'notes', 10000) && text(data, 'itemFamily', 100)
        && text(data, 'rarity', 100) && text(data, 'range', 20) && text(data, 'weaponGroup', 100)
        && text(data, 'slotKind', 100) && text(data, 'allyType', 100) && text(data, 'tier', 100)
        && text(data, 'skillId', 100) && text(data, 'howGained', 40) && shortList(data, 'grants');
    }

    function validSnapshot(data) {
      return !('snapshot' in data) || (data.snapshot is map
        && data.snapshot.keys().hasOnly(['name', 'category', 'description', 'notes', 'rarity', 'itemFamily', 'quantity'])
        && text(data.snapshot, 'name', 100) && text(data.snapshot, 'category', 20)
        && text(data.snapshot, 'description', 10000) && text(data.snapshot, 'notes', 10000)
        && text(data.snapshot, 'rarity', 100) && text(data.snapshot, 'itemFamily', 100));
    }

    function validRecord() {
      let data = request.resource.data;
      return data.keys().hasOnly(['event', 'date', 'enteredAt', 'entryId', 'entryName', 'category', 'snapshot',
          'quantity', 'note', 'source', 'link', 'restores', 'change', 'summary', 'seq'])
        && wholeNumber(data, 'seq') && text(data, 'event', 40) && text(data, 'date', 40) && text(data, 'enteredAt', 40)
        && text(data, 'entryId', 100) && text(data, 'entryName', 100) && text(data, 'category', 20)
        && wholeNumber(data, 'quantity') && text(data, 'note', 10000) && text(data, 'source', 100)
        && webLink(data, 'link') && text(data, 'restores', 100) && text(data, 'summary', 500)
        && (!('change' in data) || (data.change is map && data.change.keys().hasOnly(['from', 'to'])))
        && validSnapshot(data);
    }

    function validReport() {
      let data = request.resource.data;
      return data.keys().hasOnly(['number', 'kind', 'subject', 'message', 'characterId', 'sentAt', 'appVersion',
          'delivery'])
        && data.kind in ['missing-skill', 'bug', 'idea', 'account-problem']
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200
        && data.message is string && data.message.size() > 0 && data.message.size() <= 10000
        && wholeNumber(data, 'number') && text(data, 'characterId', 100) && text(data, 'sentAt', 40)
        && text(data, 'appVersion', 40) && (!('delivery' in data) || data.delivery == 'pending');
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && invited() && validProfile();
      allow update: if isOwner(uid) && validProfile();

      // One of the user's characters, as it is once a batched write is applied.
      function characterAfter(id) {
        return /databases/$(database)/documents/users/$(uid)/characters/$(id);
      }

      // A character-level title belongs to a character that exists, so none is
      // stored for a character the server refused (NF-3).
      function titleCharacterExists() {
        let scope = request.resource.data.get('scope', {});
        return scope.get('level', 'player') != 'character'
          || existsAfter(characterAfter(scope.get('characterId', '')));
      }

      match /titles/{titleId} {
        allow read, delete: if isOwner(uid);
        allow create: if canStore(uid) && validTitle() && titleCharacterExists();
        allow update: if canStore(uid) && validTitle() && freshTitle()
          && (request.resource.data.get('scope', {}) == resource.data.get('scope', {}) || titleCharacterExists());
      }

      // SP-1: reports to the maintainer. The sender writes one and can read it;
      // only the server (which isn't bound by these rules) marks it delivered.
      match /reports/{reportId} {
        allow read, delete: if isOwner(uid);
        allow create: if canStore(uid) && validReport();
      }

      // NF-3, CH-1: which character has a name, ignoring case. The app writes a
      // claim with the character, or with its new name, in one batch, and the
      // claim's character must have that name, exactly as written, once the batch
      // is applied (the app claims again on every rename, a change of case too).
      // A claim whose character still has the name can't be taken by another character,
      // so the second of two phones that used a name offline is refused, with the
      // character or rename the claim came with. Claims aren't released; one
      // whose character is gone or renamed can be taken over.
      function validClaim() {
        let data = request.resource.data;
        return data.keys().hasOnly(['characterId', 'name'])
          && data.characterId is string && data.characterId.size() <= 100
          && data.name is string && data.name.size() <= 100
          && existsAfter(characterAfter(data.characterId))
          && getAfter(characterAfter(data.characterId)).data.name == data.name;
      }

      function claimStale() {
        return resource.data.characterId == request.resource.data.characterId
          || !existsAfter(characterAfter(resource.data.characterId))
          || getAfter(characterAfter(resource.data.characterId)).data.name != resource.data.name;
      }

      match /characterNames/{nameId} {
        allow read, delete: if isOwner(uid);
        allow create: if canStore(uid) && validClaim();
        allow update: if canStore(uid) && validClaim() && claimStale();
      }

      match /characters/{characterId} {
        allow read, delete: if isOwner(uid);
        allow create: if canStore(uid) && validCharacter();
        allow update: if canStore(uid) && validCharacter() && freshCharacter();

        // Entries and history records are added only to a character that exists, so
        // nothing is stored under a character the server refused (NF-3).
        function characterExists() {
          return existsAfter(characterAfter(characterId));
        }

        match /entries/{entryId} {
          allow read, delete: if isOwner(uid);
          allow create: if canStore(uid) && validEntry() && characterExists();
          allow update: if canStore(uid) && validEntry() && freshEntry();
        }

        // HI-4: records are added, never edited. One goes only with its entry
        // (IN-15) or its character (CH-6, AC-5), in the same batched write.
        match /history/{recordId} {
          allow read: if isOwner(uid);
          allow create: if canStore(uid) && validRecord() && characterExists();
          allow delete: if isOwner(uid) && (
            !characterExists()
            || (resource.data.get('entryId', null) is string
                && !existsAfter(/databases/$(database)/documents/users/$(uid)/characters/$(characterId)/entries/$(resource.data.entryId)))
          );
        }
      }
    }

    // Trade listings (PV-1, section 3.2): any signed-in user can read one; only
    // its owner can create, change or remove it, and it carries only the
    // fields section 3.2 allows, never notes or the character's name. The owner
    // must be able to store records (invited profile, verified email), and the
    // listing shows their own display name.
    function validListing() {
      let data = request.resource.data;
      return data.keys().hasOnly(['ownerUid', 'ownerName', 'name', 'category', 'description', 'rarity', 'itemFamily', 'quantity'])
        && data.ownerUid == request.auth.uid && canStore(request.auth.uid)
        && data.ownerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && text(data, 'ownerName', 60) && text(data, 'name', 100) && text(data, 'category', 20)
        && text(data, 'description', 10000) && text(data, 'rarity', 100) && text(data, 'itemFamily', 100)
        && wholeNumber(data, 'quantity');
    }

    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && validListing();
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && validListing();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // The invite list (NF-13) is kept by the maintainer in the console; no user can read or change it.
  }
}
