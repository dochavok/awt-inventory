rules_version = '2';

// Server-side access rules (PV-1, NF-7). Stub for M1: nothing is allowed.
// M2 writes the real rules; tests/access/ says what they must do.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
